{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-glitch-kingdom/hit-em-with-the-docs/schemas/gaps.v1.schema.json",
  "title": "hewtd search gaps v1 (reconcile --gaps)",
  "type": "object",
  "required": ["version", "gaps"],
  "properties": {
    "version": { "const": 1 },
    "source": { "type": "string" },
    "gaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } }
  },
  "$defs": {
    "gap": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": { "type": "string", "minLength": 1 },
        "used_doc": { "type": ["string", "null"] },
        "suggested": { "enum": ["symptoms.user_phrase", "new doc"] },
        "count": { "type": "integer", "minimum": 1 },
        "last_seen": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}

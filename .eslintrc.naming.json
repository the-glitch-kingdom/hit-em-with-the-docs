{
  "extends": ["./.eslintrc.json"],
  "rules": {
    "@typescript-eslint/naming-convention": [
      "error",
      { "selector": "variable", "format": ["snake_case", "UPPER_CASE"], "leadingUnderscore": "allow" },
      { "selector": "function", "format": ["snake_case"], "leadingUnderscore": "allow" },
      { "selector": "parameter", "format": ["snake_case"], "leadingUnderscore": "allow" },
      { "selector": "method", "format": ["snake_case"], "leadingUnderscore": "allow" },
      { "selector": "typeLike", "format": ["PascalCase"] }
    ],
    "id-length": [
      "error",
      { "min": 2, "properties": "never", "exceptions": ["i", "j", "a", "b", "_"] }
    ],
    "id-denylist": [
      "error",
      "cfg", "conf", "opts", "opt", "rel", "ref", "refs", "err", "ex", "res", "rec", "out", "acc", "raw",
      "fm", "kb", "cwd", "ext", "msg", "src", "env", "pkg", "abs", "def", "cand", "cands", "hit", "hits",
      "sib", "sibs", "led", "str", "tmp", "val", "idx", "num", "arr", "obj", "fn", "cb", "ctx", "dst",
      "projectRoot", "repoRoot", "docsPath", "docsDir", "docsRoot", "rootPath", "workingDir", "filePath"
    ]
  }
}
